{
  "name": "Cyberpunk",
  "author": "Zyared",
  "description": "Arasaka Corporate Systems: a quiet graphite workspace, crimson navigation, silver typography and personnel terminal boot.",
  "version": "2.0.0",
  "header_image": "assets/logo.svg",
  "splash_image": "assets/logo.svg",
  "tags": [
    "dark",
    "neon",
    "animated"
  ],
  "github": {
    "owner": "Zyared",
    "repo_name": "steam-cyberdeck-theme"
  },
  "Steam-WebKit": "webkit.css",
  "Patches": [
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "libraryroot.custom.css",
      "TargetJs": "libraryroot.custom.js"
    },
    {
      "MatchRegexString": "^(Войти в Steam|Sign in to Steam)$",
      "TargetCss": "login.custom.css"
    },
    {
      "MatchRegexString": "^notificationtoasts",
      "TargetCss": "toast.custom.css"
    },
    {
      "MatchRegexString": ".DesktopToastPopup",
      "TargetCss": "toast.custom.css"
    },
    {
      "MatchRegexString": "(Menu|Supernav)$",
      "TargetCss": "libraryroot.custom.css"
    },
    {
      "MatchRegexString": ".ModalDialogPopup",
      "TargetCss": "libraryroot.custom.css"
    },
    {
      "MatchRegexString": ".FullModalOverlay",
      "TargetCss": "libraryroot.custom.css"
    },
    {
      "MatchRegexString": ".friendsui-container",
      "TargetCss": "friends.custom.css"
    }
  ],
  "Conditions": {
    "Color scheme": {
      "default": "Arasaka",
      "description": "Main colours of the whole theme. Restart Steam after changing it.",
      "values": {
        "Arasaka": {},
        "Blood red": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "opt/scheme-blood.css"
          }
        },
        "Ice cyan": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "opt/scheme-ice.css"
          }
        },
        "Toxic green": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "opt/scheme-toxic.css"
          }
        },
        "Neon violet": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "opt/scheme-violet.css"
          }
        },
        "Hot pink": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "opt/scheme-pink.css"
          }
        }
      }
    },
    "Boot sequence": {
      "default": "yes",
      "description": "Short jack-in screen when Steam starts.",
      "values": {
        "yes": {},
        "no": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "opt/no-boot.css"
          }
        }
      }
    },
    "HUD readout": {
      "default": "yes",
      "description": "Clock and status line in the bottom bar.",
      "values": {
        "yes": {},
        "no": {
          "TargetCss": {
            "affects": [
              "^Steam$"
            ],
            "src": "opt/no-hud.css"
          }
        }
      }
    }
  }
}
